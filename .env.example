# Autobahn Environment Variables
# Copy this file to .env or .env.local to customize local settings

# Controls / Development Mode
# By default, keyboard controls are automatically enabled during `npm run dev`.
# You can also explicitly toggle keyboard controls on desktop here:
VITE_DEV_CONTROLS=true

# Vite Server Configuration (optional)
# VITE_PORT=5173
# VITE_HOST=0.0.0.0

